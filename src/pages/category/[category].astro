---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Statically generate category routes based on plant data files
export async function getStaticPaths() {
  const allPlants = await getCollection('plants');
  
  // Extract all categories used
  const categorySet = new Set<string>();
  allPlants.forEach(plant => {
    plant.data.categories.forEach(cat => categorySet.add(cat));
  });

  // Map category details
  const categoryDetails: Record<string, { name: string; description: string; icon: string; tips: string }> = {
    'indoor-plants': {
      name: 'Indoor Plants',
      description: 'Houseplants that thrive inside rooms, apartments, and offices. Highly adaptable to artificial light and container bound growth.',
      icon: '🏠',
      tips: 'Ensure leaves are wiped free of dust monthly so they can synthesize light. Keep away from direct vents and drafty doors.'
    },
    'outdoor-plants': {
      name: 'Outdoor Plants',
      description: 'Garden beds, boundary shrubs, and container plants that require full sunlight exposure and open-air ventilation.',
      icon: '☀️',
      tips: 'Mulch heavily to retain soil moisture under the blazing afternoon sun. Water deeply in the morning rather than afternoon.'
    },
    'vegetables': {
      name: 'Vegetables',
      description: 'Edible garden crops and vines providing fresh kitchen ingredients. Heavy feeders requiring high organic compost levels.',
      icon: '🍅',
      tips: 'Add bone meal to the soil to provide adequate calcium and prevent end rot in fruits. Provide support stakes early in growth.'
    },
    'flowers': {
      name: 'Flowers',
      description: 'Flowering shrubs and perennials grown for their colorful displays, visual contrast, and pollinator attraction properties.',
      icon: '🌸',
      tips: 'Regularly deadhead (remove) spent blooms to force the plant to generate a new flush of flower buds instead of seeds.'
    },
    'succulents': {
      name: 'Succulents',
      description: 'Drought-tolerant fleshy leaf plants. Ideal for sandy containers, hot climates, and busy gardeners.',
      icon: '🌵',
      tips: 'Water deeply but very rarely. Pot only in gritty clay or terracotta pots using specialized sandy cactus soil mixes.'
    },
    'medicinal-plants': {
      name: 'Medicinal Plants',
      description: 'Herbs and plants historically harvested for natural skin treatments, calming teas, and organic remedies.',
      icon: '🌿',
      tips: 'Prune mature outer leaves from the base of the plant to keep offsets growing. Avoid any synthetic pesticide sprays.'
    },
    'low-maintenance-plants': {
      name: 'Low Maintenance Plants',
      description: 'Hardy plants capable of surviving weeks of neglect. Perfect for beginners and low light environments.',
      icon: '🪴',
      tips: 'Neglect is often better than overcare for these species. Allow soil to dry completely before considering watering.'
    },
    'fruit-plants': {
      name: 'Fruit Plants',
      description: 'Fruiting garden crops and orchard shrubs. High sunlight requirements and specific harvest periods.',
      icon: '🍓',
      tips: 'Prune dead canes yearly and feed high-potassium nutrients during flowering to increase the weight and sweetness of fruits.'
    }
  };

  return Array.from(categorySet).map(catSlug => {
    const details = categoryDetails[catSlug] || {
      name: catSlug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
      description: `Plants belonging to the ${catSlug} botanical category.`,
      icon: '🌱',
      tips: 'Maintain consistent soil checking and provide adequate light for species growth.'
    };

    return {
      params: { category: catSlug },
      props: { 
        slug: catSlug,
        details,
        plants: allPlants.filter(p => p.data.categories.includes(catSlug))
      }
    };
  });
}

const { slug, details, plants } = Astro.props;

// Breadcrumbs data
const breadcrumbs = [
  { label: 'Encyclopedia', url: '/plants' },
  { label: details.name, url: `/category/${slug}` }
];

// JSON-LD ItemList Category Schema
const categoryLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${details.name} Category Listings`,
  "description": details.description,
  "url": `https://growmyplant.online/category/${slug}`,
  "numberOfItems": plants.length,
  "itemListElement": plants.map((p, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "url": `https://growmyplant.online/plants/${p.data.slug}`
  }))
};
---

<Layout
  title={`${details.name} Care Guides — ${plants.length} Species | GrowMyPlant`}
  description={`Browse ${plants.length} ${details.name.toLowerCase()} care guides with watering schedules, sunlight requirements, soil tips, and propagation methods. ${details.description}`}
  jsonLd={[categoryLd]}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Category Header Card -->
    <div class="bg-white border border-border-nature p-8 rounded-organic-lg shadow-2xs mb-10 flex flex-col md:flex-row gap-6 items-center md:items-start text-center md:text-left">
      <div class="text-5xl p-4 bg-brand-mint rounded-organic border border-border-nature flex items-center justify-center">
        {details.icon}
      </div>
      <div>
        <h1 class="font-serif font-bold text-3xl text-text-charcoal leading-tight">{details.name}</h1>
        <p class="text-sm text-text-muted mt-2 leading-relaxed max-w-3xl">
          {details.description}
        </p>
        <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-brand-forest bg-brand-mint px-3 py-1.5 rounded-sm border border-border-nature">
          <span>📚 {plants.length} {plants.length === 1 ? 'Species' : 'Species'} cataloged</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Care Tips Box (desktop only) -->
      <div class="hidden lg:block lg:col-span-1 bg-white border border-border-nature p-6 rounded-organic shadow-xs h-fit sticky top-20">
        <h2 class="font-serif font-bold text-lg text-text-charcoal mb-4 border-b border-border-nature pb-3">Expert Care Tip</h2>
        <div class="text-xs leading-relaxed text-text-muted space-y-3">
          <div class="text-xl">💡</div>
          <p class="font-medium text-text-charcoal">For {details.name}:</p>
          <p>{details.tips}</p>
        </div>
      </div>

      <!-- Plants Catalog List -->
      <div class="lg:col-span-3">
        
        <!-- Mobile Care Tip Banner -->
        <div class="lg:hidden mb-5 p-4 bg-brand-mint border border-border-nature rounded-organic text-xs text-text-muted flex gap-3 items-start">
          <span class="text-xl flex-shrink-0">💡</span>
          <p><strong class="text-text-charcoal">Tip:</strong> {details.tips}</p>
        </div>

        <!-- Search Input -->
        <div class="mb-6 relative">
          <label for="category-search" class="sr-only">Search within {details.name}</label>
          <input
            type="search"
            id="category-search"
            placeholder={`Search within ${details.name}...`}
            class="w-full bg-white border border-border-nature px-4 py-3 pl-10 rounded-organic shadow-2xs focus:outline-none focus:ring-2 focus:ring-brand-emerald focus:border-transparent text-sm text-text-charcoal"
          />
          <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted select-none pointer-events-none">
            🔍
          </div>
        </div>

        <!-- Empty State -->
        <div id="no-results" class="hidden text-center py-12 bg-white border border-border-nature rounded-organic p-8 mb-6">
          <div class="text-4xl mb-3">🌱</div>
          <h3 class="font-serif font-bold text-lg text-text-charcoal">No plants found</h3>
          <p class="text-sm text-text-muted mt-1">Try adjusting your search terms or view another category.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="plants-grid">
          {plants.map(plant => (
            <a 
              href={`/plants/${plant.data.slug}`} 
              class="plant-card group bg-white dark:bg-[#141b18] border border-border-nature rounded-organic overflow-hidden shadow-2xs hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col"
              data-common={plant.data.commonName.toLowerCase()}
              data-scientific={plant.data.scientificName.toLowerCase()}
              data-nicknames={JSON.stringify(plant.data.nicknames.map(n => n.toLowerCase()))}
              data-categories={JSON.stringify(plant.data.categories.map(c => c.toLowerCase()))}
            >
              <!-- Plant Image: explicit width/height prevents CLS -->
              <div class="aspect-[4/3] overflow-hidden bg-brand-mint border-b border-border-nature">
                <img
                  src={plant.data.image}
                  alt={`${plant.data.commonName} (${plant.data.scientificName}) plant`}
                  loading="lazy"
                  width="400"
                  height="300"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="p-4 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex gap-2">
                    <span class="text-[10px] font-mono font-bold text-brand-emerald bg-emerald-50 px-2 py-0.5 rounded-sm border border-emerald-100 uppercase">
                      {plant.data.indoorOutdoor}
                    </span>
                    <span class="text-[10px] font-mono font-bold text-brand-forest uppercase bg-brand-mint px-2 py-0.5 rounded-sm border border-border-nature">
                      {plant.data.difficulty}
                    </span>
                  </div>
                  <h3 class="font-serif font-bold text-base text-text-charcoal mt-2 group-hover:text-brand-forest leading-snug">
                    {plant.data.commonName}
                  </h3>
                  <p class="text-xs text-text-muted italic mt-0.5">{plant.data.scientificName}</p>
                  <p class="text-xs text-text-muted mt-2 line-clamp-2 leading-relaxed">
                    {plant.data.overview}
                  </p>
                </div>
                <div class="text-[11px] text-text-light mt-3 pt-3 border-t border-border-nature flex justify-between items-center">
                  <span>Zones: {plant.data.usdaZones.join(', ')}</span>
                  <span class="text-brand-forest font-bold">View Care →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>

  </div>

  <!-- Client-side Category list filtering -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById('category-search');
      const cards = document.querySelectorAll('.plant-card');
      const noResults = document.getElementById('no-results');

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const query = searchInput.value.toLowerCase().trim();
          const queryWords = query.split(/\s+/).filter(Boolean);
          let visibleCount = 0;

          cards.forEach(card => {
            if (!query) {
              card.classList.remove('hidden');
              visibleCount++;
              return;
            }

            const common = card.getAttribute('data-common') || '';
            const scientific = card.getAttribute('data-scientific') || '';
            const nicknames = JSON.parse(card.getAttribute('data-nicknames') || '[]');
            const categories = JSON.parse(card.getAttribute('data-categories') || '[]');

            const plantText = [
              common,
              scientific,
              ...nicknames,
              ...categories
            ].join(' ').toLowerCase();

            const plantWords = plantText.split(/[\s\-_,.]+/).filter(Boolean);

            const matches = queryWords.every(qWord => {
              return plantWords.some(pWord => pWord.startsWith(qWord));
            });

            if (matches) {
              card.classList.remove('hidden');
              visibleCount++;
            } else {
              card.classList.add('hidden');
            }
          });

          if (noResults) {
            if (visibleCount === 0) {
              noResults.classList.remove('hidden');
            } else {
              noResults.classList.add('hidden');
            }
          }
        });
      }
    })();
  </script>
</Layout>
