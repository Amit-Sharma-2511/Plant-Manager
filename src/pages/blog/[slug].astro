---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Statically generate routes for all blog posts
export async function getStaticPaths() {
  const allBlogs = await getCollection('blog');
  return allBlogs.map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data;

// Breadcrumbs data
const breadcrumbs = [
  { label: 'Blog', url: '/blog' },
  { label: data.title, url: `/blog/${post.id}` }
];

// JSON-LD Article Schema
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": data.title,
  "description": data.description,
  "image": data.coverImage,
  "author": {
    "@type": "Organization",
    "name": "GrowMyPlant",
    "url": "https://growmyplant.online"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GrowMyPlant",
    "logo": {
      "@type": "ImageObject",
      "url": "https://growmyplant.online/favicon.svg"
    }
  },
  "datePublished": data.publishDate
};
---

<Layout
  title={`${data.title} - GrowMyPlant Blog`}
  description={data.description}
  image={data.coverImage}
  type="article"
  jsonLd={[articleLd]}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Blog Article Header -->
    <header class="text-center mb-10">
      <div class="flex flex-wrap justify-center gap-2 mb-4">
        {data.tags.map(tag => (
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-brand-emerald bg-emerald-50 px-2.5 py-1 rounded-sm border border-emerald-100">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-text-charcoal leading-tight max-w-3xl mx-auto">
        {data.title}
      </h1>
      <p class="text-sm sm:text-base text-text-muted mt-4 max-w-2xl mx-auto">
        {data.description}
      </p>

      <!-- Author and Date meta -->
      <div class="mt-6 flex items-center justify-center gap-3 text-xs text-text-light font-mono">
        <span>By {data.author}</span>
        <span class="text-border-nature-dark">•</span>
        <time datetime={data.publishDate}>
          {new Date(data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
      </div>
    </header>

    <!-- Cover Image -->
    <div class="aspect-video rounded-organic-lg overflow-hidden border border-border-nature shadow-sm mb-12 bg-brand-mint">
      <img
        src={data.coverImage}
        alt={`Cover illustration for: ${data.title}`}
        class="w-full h-full object-cover"
        onerror="this.onerror=null; this.src='/images/blog/money-plant.webp'"
      />
    </div>

    <!-- Article Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Back Link & Contents Sidebar (Desktop) -->
      <aside class="hidden lg:block lg:col-span-1 space-y-6 text-xs" aria-label="Article Actions">
        <a href="/blog" class="inline-flex items-center gap-1.5 font-bold text-brand-forest hover:text-brand-emerald transition-colors">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Blog List
        </a>
        <div class="bg-white border border-border-nature p-4 rounded-organic shadow-2xs">
          <h3 class="font-bold text-text-charcoal uppercase tracking-wider mb-2">Share Article</h3>
          <ul class="space-y-2 text-text-muted font-medium">
            <li><a href="#" onclick="event.preventDefault(); alert('Link copied to clipboard!');" class="hover:text-brand-forest">Copy Link 🔗</a></li>
            <li><a href="#" onclick="event.preventDefault(); window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(document.title) + '&url=' + encodeURIComponent(window.location.href));" class="hover:text-brand-forest">Share on X (Twitter)</a></li>
          </ul>
        </div>
      </aside>

      <!-- Markdown Article Text -->
      <div class="lg:col-span-3 bg-white border border-border-nature p-6 sm:p-10 rounded-organic-lg shadow-2xs">
        <div class="rich-text leading-relaxed">
          <Content />
        </div>

        <!-- Social Footer for Mobile -->
        <div class="lg:hidden mt-8 pt-6 border-t border-border-nature flex items-center justify-between text-xs">
          <a href="/blog" class="font-bold text-brand-forest hover:underline">← Back to Blog</a>
          <button onclick="alert('Link copied to clipboard!')" class="text-text-muted hover:text-brand-forest font-semibold">Share Link 🔗</button>
        </div>
      </div>

    </div>
  </article>

  <!-- Scoped Styles for Markdown Content rendering -->
  <style is:global>
    .rich-text h2 {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-brand-forest);
      margin-top: 2rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-nature);
      padding-bottom: 0.5rem;
    }
    .rich-text h3 {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--color-text-charcoal);
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
    }
    .rich-text p {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-top: 0;
      margin-bottom: 1.25rem;
      line-height: 1.75;
    }
    .rich-text ul, .rich-text ol {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
    .rich-text ul {
      list-style-type: disc;
    }
    .rich-text ol {
      list-style-type: decimal;
    }
    .rich-text li {
      margin-bottom: 0.5rem;
      line-height: 1.6;
    }
    .rich-text strong {
      font-weight: 600;
      color: var(--color-text-charcoal);
    }
    .rich-text blockquote {
      border-left: 4px solid var(--color-brand-emerald);
      padding-left: 1rem;
      margin-left: 0;
      margin-right: 0;
      font-style: italic;
      color: var(--color-text-muted);
    }
    .rich-text hr {
      border: 0;
      border-top: 1px solid var(--color-border-nature);
      margin: 2rem 0;
    }
  </style>
</Layout>
